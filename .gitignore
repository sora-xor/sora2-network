# Generated by Cargo
# will have compiled files and executables
**/target/
**/target-*/
**/node_modules/
**/artifacts/
**/cache/
**/out/
# These are backup files generated by rustfmt
**/*.rs.bk

.DS_Store

# The cache for chain data in container
.local
.cargo/*
.cargo*

local-test

.idea
.gradle
.venv*

# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class

tmp
/ethereum/java-wrapper/build/libs/*.jar
db-stg-chain*

# Generated by run_script.sh
db?

# Generated by integration-tests/run-local-network.py when --workdir is set in-repo
integration-tests/.workdir/

.vscode/launch.json

# Generated folder for benchmark results (order book extra benchmarks)
benches/

# SCCP local matrix logs
misc/sccp/logs/

# SCCP fuzz-generated inputs and crash artifacts
pallets/sccp/fuzz/corpus/
pallets/sccp/fuzz/artifacts/
pallets/sccp/fuzz/Cargo.lock

# Generated security docs
docs/security*
/security_best_practices_report.md

# Root-level local build outputs
/.tmp-docker-substrate*/
/framenode
/framenode-*
/framenode_runtime.compact*
/subwasm_report.json

# Local council delivery bundles and superseded runtime candidates
# Keep canonical release Wasm, metadata, governance calls and documentation tracked.
/runtime-upgrade-*-superseded*/
/sora-runtime-*-council-*.zip
/sora-runtime-*-council-*.zip.*

# Rebuildable source bundles and local runtime-upgrade replay data
/runtime-upgrade-*/source.tar.gz
/runtime-upgrade-*/source-changes.bundle
/runtime-upgrade-*/validation/*.log
/runtime-upgrade-*/validation/*.snap
/runtime-upgrade-*/validation/live-metadata.*
/runtime-upgrade-*/validation/live-runtime-*.wasm
/runtime-upgrade-*/validation/reference-runtime-*/
/runtime-upgrade-*/validation/source-changes.patch

# Investigation build outputs; retain scripts, regression tests and summary reports
/misc/bridge-rpc-reliability/validation/*.log
/misc/slash-investigation/*.log
/misc/slash-investigation/*.wasm
/misc/slash-investigation/*.tar.gz
/misc/slash-investigation/lifecycle-release-metadata.json
/misc/slash-investigation/candidate-source.patch

# Local runtime rehearsal state snapshots
/runtime-rehearsal-*/validation/**/*.snap

# Rehearsal and validation outputs are local evidence, not source. Harness code,
# the npm manifests CI audits and governance release packages stay tracked.
/runtime-rehearsal-*/**/*.json
/runtime-rehearsal-*/**/*.gz
/runtime-rehearsal-*/**/*.log
/runtime-rehearsal-*/**/*.stderr
/runtime-rehearsal-*/**/*.stdout
