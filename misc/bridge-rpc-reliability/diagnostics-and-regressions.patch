+impl OffchainExternalities for HttpStatusOffchainExt {
+    fn is_validator(&self) -> bool {
+        self.0.is_validator()
+    }
+
+    fn network_state(&self) -> Result<OpaqueNetworkState, ()> {
+        self.0.network_state()
