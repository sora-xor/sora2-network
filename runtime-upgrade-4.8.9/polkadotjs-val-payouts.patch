+// Copyright 2017-2026 @polkadot/apps-config authors & contributors
+// SPDX-License-Identifier: Apache-2.0
+
+import type { Observable } from 'rxjs';
+import type { DeriveApi, DeriveEraRewards } from '@polkadot/api-derive/types';
+import type { EraIndex } from '@polkadot/types/interfaces';
+
+import { map, of } from 'rxjs';
+
+import { _erasRewards } from '@polkadot/api-derive/staking';
+import { memo } from '@polkadot/api-derive/util';
+
+// SORA stakes XOR and records VAL rewards separately. The upstream staking
+// reward is deliberately zero to prevent an additional native XOR mint.
+export function erasRewards (instanceId: string, api: DeriveApi): (eras: EraIndex[], withActive: boolean) => Observable<DeriveEraRewards[]> {
+  const standardRewards = _erasRewards(instanceId, api);
+
+  return memo(instanceId, (eras: EraIndex[], withActive: boolean): Observable<DeriveEraRewards[]> => {
+    const valRewards = api.query.xorFee?.valStakingEraReward;
+
+    // Older SORA runtimes paid VAL from the staking pallet itself.
+    if (!valRewards) {
+      return standardRewards(eras, withActive);
+    }
+
+    if (!eras.length) {
+      return of([]);
+    }
+
+    // Keep this separate from the standard era-reward cache: it may contain
+    // zero XOR rewards cached before the VAL-aware derive was installed.
+    return valRewards.multi(eras).pipe(
+      map((rewards): DeriveEraRewards[] => eras.map((era, index) => ({
+        era,
+        eraReward: api.registry.createType('Balance', rewards[index])
+      })))
+    );
+  });
+}
