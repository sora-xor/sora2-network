+// Copyright 2017-2026 @polkadot/apps-config authors & contributors
+// SPDX-License-Identifier: Apache-2.0
+
+/// <reference types="@polkadot/dev-test/globals.d.ts" />
+
+import type { DeriveApi } from '@polkadot/api-derive/types';
+import type { EraIndex } from '@polkadot/types/interfaces';
+
+import { BehaviorSubject, firstValueFrom, of, skip } from 'rxjs';
+
+import { getAvailableDerives } from '@polkadot/api-derive';
+import { TypeRegistry } from '@polkadot/types';
+
+import definitions from '../soraSubstrate.js';
+import { erasRewards } from './derives.js';
+
+const registry = new TypeRegistry();
+const eras = [registry.createType<EraIndex>('EraIndex', 7), registry.createType<EraIndex>('EraIndex', 8)];
+
+describe('SORA staking era rewards', (): void => {
+  it('exposes VAL rewards even when standard staking rewards are zero', async (): Promise<void> => {
+    let requested: EraIndex[] = [];
+    const api = {
+      query: {
+        staking: { erasValidatorReward: { multi: () => {
+          throw new Error('must not read XOR rewards');
+        } } },
+        xorFee: {
+          valStakingEraReward: {
+            multi: (values: EraIndex[]) => {
+              requested = values;
+
+              return of([registry.createType('Balance', '57813980591259333097'), registry.createType('Balance', 0)]);
+            }
+          }
+        }
+      },
+      registry
+    } as unknown as DeriveApi;
+    const result = await firstValueFrom(erasRewards('sora-val-rewards', api)(eras, false));
+
+    expect(requested).toEqual(eras);
+    expect(result.map(({ era }) => era.toNumber())).toEqual([7, 8]);
+    expect(result.map(({ eraReward }) => eraReward.toString())).toEqual(['57813980591259333097', '0']);
+  });
+
+  it('keeps a zero VAL reward at zero instead of falling back to another currency', async (): Promise<void> => {
+    const api = {
+      query: {
+        staking: { erasValidatorReward: { multi: () => of([registry.createType('Option<Balance>', 1000)]) } },
+        xorFee: { valStakingEraReward: { multi: () => of([registry.createType('Balance', 0)]) } }
+      },
+      registry
+    } as unknown as DeriveApi;
+    const result = await firstValueFrom(erasRewards('sora-zero-val', api)(eras.slice(0, 1), false));
+
+    expect(result[0].eraReward.isZero()).toBe(true);
+  });
+
+  it('returns no rewards without issuing a query when no eras are requested', async (): Promise<void> => {
+    const api = {
+      query: { xorFee: { valStakingEraReward: { multi: () => {
+        throw new Error('unexpected query');
+      } } } },
+      registry
+    } as unknown as DeriveApi;
+
+    expect(await firstValueFrom(erasRewards('sora-empty-eras', api)([], false))).toEqual([]);
+  });
+
+  it('uses standard rewards for runtimes without the separate VAL storage', async (): Promise<void> => {
+    const api = {
+      query: {
+        staking: {
+          erasValidatorReward: {
+            multi: () => of([registry.createType('Option<Balance>', 123), registry.createType('Option<Balance>')])
+          }
+        }
+      },
+      registry
+    } as unknown as DeriveApi;
+    const result = await firstValueFrom(erasRewards('sora-legacy-rewards', api)(eras, true));
+
+    expect(result.map(({ eraReward }) => eraReward.toString())).toEqual(['123', '0']);
+  });
+
+  it('updates rewards while an active era accrues VAL', async (): Promise<void> => {
+    const rewards = new BehaviorSubject([registry.createType('Balance', 100)]);
+    const api = {
+      query: { xorFee: { valStakingEraReward: { multi: () => rewards } } },
+      registry
+    } as unknown as DeriveApi;
+    const stream = erasRewards('sora-active-rewards', api)(eras.slice(0, 1), true);
+    const updated = firstValueFrom(stream.pipe(skip(1)));
+
+    rewards.next([registry.createType('Balance', 200)]);
+    expect((await updated)[0].eraReward.toString()).toBe('200');
+  });
+
+  it('exports the reward derive through the SORA override bundle', (): void => {
+    expect(definitions.derives?.staking._erasRewards).toBe(erasRewards);
+    expect(!!definitions.types?.length).toBe(true);
+  });
+
+  it('preserves the staking account and reward APIs after custom derive injection', (): void => {
+    const api = {
+      query: { staking: { erasRewardPoints: () => undefined } },
+      registry,
+      runtimeVersion: { specName: 'sora-substrate' }
+    } as unknown as DeriveApi;
+    const available = getAvailableDerives('sora-injected-derives', api, definitions.derives);
+
+    expect(typeof available.staking.accounts).toBe('function');
+    expect(typeof available.staking.stakerRewardsMultiEras).toBe('function');
+    expect(typeof available.staking.erasHistoric).toBe('function');
+    expect(typeof available.staking._erasRewards).toBe('function');
+  });
+});
