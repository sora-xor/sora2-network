@@ -0,0 +1,179 @@
+// Copyright 2017-2026 @polkadot/apps-config authors & contributors
+// SPDX-License-Identifier: Apache-2.0
+
+/// <reference types="@polkadot/dev-test/globals.d.ts" />
+
+import type { DeriveApi, DeriveStakerReward } from '@polkadot/api-derive/types';
+import type { AccountId, Balance, EraIndex } from '@polkadot/types/interfaces';
+
+import { BehaviorSubject, combineLatest, firstValueFrom, of, skip } from 'rxjs';
+
+import { _stakerExposures } from '@polkadot/api-derive/staking';
+import { TypeRegistry } from '@polkadot/types';
+import { BN } from '@polkadot/util';
+
+import definitions from '../soraSubstrate.js';
+import { eraExposure, stakerRewards, validatorRewards } from './stakingRewards.js';
+
+const registry = new TypeRegistry();
+
+registry.register({
+  // eslint-disable-next-line sort-keys -- codec field order matches the runtime
+  SoraTestOverview: { total: 'Balance', own: 'Balance', nominatorCount: 'u32', pageCount: 'u32' },
+  // eslint-disable-next-line sort-keys -- codec field order matches the runtime
+  SoraTestPage: { pageTotal: 'Compact<Balance>', others: 'Vec<IndividualExposure>' }
+});
+
+const era = registry.createType<EraIndex>('EraIndex', 989);
+const account = (digit: string): AccountId => registry.createType<AccountId>('AccountId', `0x${digit.repeat(64)}`);
+const validatorA = account('1');
+const validatorB = account('2');
+const alice = account('3');
+const bob = account('4');
+const balance = (value: number): Balance => registry.createType<Balance>('Balance', value);
+let fixtureId = 0;
+
+interface ValidatorFixture {
+  claimed?: number[];
+  commission?: number;
+  id: AccountId;
+  legacy?: boolean;
+  legacyClaimed?: boolean;
+  own: number;
+  pages: [AccountId, number][][];
+}
+
+function fixture (validators: ValidatorFixture[], reversePages = false) {
+  const id = `sora-paged-${fixtureId++}`;
+  const claimed = new BehaviorSubject(validators.map(({ claimed = [] }) => registry.createType('Vec<u32>', claimed)));
+  const total = ({ own, pages }: ValidatorFixture): number => own + pages.flat().reduce((sum, [, stake]) => sum + stake, 0);
+  const pageEntries = validators.flatMap(({ id, legacy, pages }) => legacy
+    ? []
+    : pages.map((stakers, page) => [
+      { args: [era, id, registry.createType('u32', page)] },
+      registry.createType('Option<SoraTestPage>', { others: stakers.map(([who, value]) => ({ value, who })), pageTotal: stakers.reduce((sum, [, stake]) => sum + stake, 0) })
+    ]));
+  const api = {
+    derive: { staking: {} },
+    query: {
+      staking: {
+        claimedRewards: { multi: () => claimed },
+        erasStakersClipped: { entries: () => of(validators.filter(({ legacy }) => legacy).map((val) => [{ args: [era, val.id] }, registry.createType('Exposure', { others: val.pages.flat().map(([who, value]) => ({ value, who })), own: val.own, total: total(val) })])) },
+        erasStakersOverview: { entries: () => of(validators.filter(({ legacy }) => !legacy).map((val) => [{ args: [era, val.id] }, registry.createType('Option<SoraTestOverview>', { nominatorCount: val.pages.flat().length, own: val.own, pageCount: val.pages.length, total: total(val) })])) },
+        erasStakersPaged: { entries: () => of(reversePages ? pageEntries.reverse() : pageEntries) }
+      },
+      xorFee: { valStakingEraReward: {} }
+    },
+    registry
+  } as unknown as DeriveApi;
+
+  api.derive.staking._eraExposure = eraExposure(id, api);
+  Object.assign(api.derive.staking, { _erasExposure: (eras: EraIndex[]) => combineLatest(eras.map((era) => api.derive.staking._eraExposure(era))) });
+  api.derive.staking._stakerExposures = _stakerExposures(id, api);
+  api.derive.staking._stakerRewardsEras = () => of([
+    [{ era, eraPoints: balance(validators.length), validators: Object.fromEntries(validators.map(({ id }) => [id.toString(), balance(1)])) }],
+    [{ era, validators: Object.fromEntries(validators.map(({ commission = 0, id }) => [id.toString(), { commission: registry.createType('Compact<Perbill>', commission) }])) }],
+    [{ era, eraReward: balance(1000) }]
+  ]) as ReturnType<DeriveApi['derive']['staking']['_stakerRewardsEras']>;
+  api.derive.staking.queryMulti = () => of(validators.map(({ id, legacyClaimed }) => ({ accountId: id, stakingLedger: { legacyClaimedRewards: registry.createType('Vec<u32>', legacyClaimed ? [era] : []) } }))) as ReturnType<DeriveApi['derive']['staking']['queryMulti']>;
+
+  return { api, claimed, rewards: stakerRewards(id, api), validatorPayouts: validatorRewards(id, api) };
+}
+
+function values (rewards: DeriveStakerReward[][]): string[] {
+  return rewards.map((eras) => eras.reduce((sum, { validators }) => Object.values(validators).reduce((sum, { value }) => sum.add(value), sum), new BN(0)).toString());
+}
+
+describe('SORA paged staking rewards', (): void => {
+  for (const reversed of [false, true]) {
+    it(`retains every page and validator own stake (reversed storage order: ${String(reversed)})`, async (): Promise<void> => {
+      const { rewards } = fixture([{ id: validatorA, own: 10, pages: [[[alice, 30]], [[bob, 60]]] }], reversed);
+      const result = await firstValueFrom(rewards([validatorA.toString(), alice.toString(), bob.toString()], [era]));
+
+      expect(values(result)).toEqual(['100', '300', '600']);
+      expect(result.every((eras) => eras[0].isClaimed === false)).toBe(true);
+    });
+  }
+
+  it('supports a validator with own stake but no nominator page entry', async (): Promise<void> => {
+    const { rewards } = fixture([{ id: validatorA, own: 100, pages: [] }]);
+
+    expect(values(await firstValueFrom(rewards([validatorA.toString()], [era])))).toEqual(['1000']);
+  });
+
+  it('updates pending page rewards and pays own stake only on page zero', async (): Promise<void> => {
+    const { claimed, rewards } = fixture([{ commission: 250_000_000, id: validatorA, own: 10, pages: [[[alice, 30]], [[bob, 60]]] }]);
+    const stream = rewards([validatorA.toString(), alice.toString(), bob.toString()], [era]);
+
+    expect(values(await firstValueFrom(stream))).toEqual(['325', '225', '450']);
+
+    const next = firstValueFrom(stream.pipe(skip(1)));
+
+    claimed.next([registry.createType('Vec<u32>', [0])]);
+    expect(values(await next)).toEqual(['150', '0', '450']);
+
+    const complete = firstValueFrom(stream.pipe(skip(1)));
+
+    claimed.next([registry.createType('Vec<u32>', [0, 1])]);
+    expect(values(await complete)).toEqual(['0', '0', '0']);
+  });
+
+  it('keeps the unpaid validator when another validator in the same era is fully claimed', async (): Promise<void> => {
+    const { rewards } = fixture([
+      { claimed: [0], id: validatorA, own: 10, pages: [[[alice, 90]]] },
+      { id: validatorB, own: 10, pages: [[[alice, 90]]] }
+    ]);
+    const result = await firstValueFrom(rewards([alice.toString()], [era]));
+
+    expect(values(result)).toEqual(['450']);
+    expect(Object.keys(result[0][0].validators)).toEqual([validatorB.toString()]);
+    expect(result[0][0].isClaimed).toBe(false);
+  });
+
+  it('retains legacy clipped exposure when paged storage also exists', async (): Promise<void> => {
+    const { rewards } = fixture([{ id: validatorA, legacy: true, own: 10, pages: [[[alice, 90]]] }]);
+
+    expect(values(await firstValueFrom(rewards([validatorA.toString(), alice.toString()], [era])))).toEqual(['100', '900']);
+  });
+
+  it('removes legacy claims using the validator ledger', async (): Promise<void> => {
+    const { rewards } = fixture([{ id: validatorA, legacy: true, legacyClaimed: true, own: 10, pages: [[[alice, 90]]] }]);
+
+    expect(values(await firstValueFrom(rewards([alice.toString()], [era])))).toEqual(['0']);
+  });
+
+  it('includes historical paid pages when active/historical reward information is requested', async (): Promise<void> => {
+    const { rewards } = fixture([{ claimed: [0], id: validatorA, own: 10, pages: [[[alice, 90]]] }]);
+
+    expect(values(await firstValueFrom(rewards([alice.toString()], [era], true)))).toEqual(['900']);
+  });
+
+  it('updates Own validators immediately while account snapshots remain unchanged', async (): Promise<void> => {
+    const { claimed, validatorPayouts } = fixture([{ commission: 250_000_000, id: validatorA, own: 10, pages: [[[alice, 30]], [[bob, 60]]] }]);
+    const stream = validatorPayouts([validatorA.toString()], [era]);
+
+    expect(values(await firstValueFrom(stream))).toEqual(['1000']);
+
+    const partial = firstValueFrom(stream.pipe(skip(1)));
+
+    claimed.next([registry.createType('Vec<u32>', [0])]);
+    expect(values(await partial)).toEqual(['600']);
+
+    const complete = firstValueFrom(stream.pipe(skip(1)));
+
+    claimed.next([registry.createType('Vec<u32>', [0, 1])]);
+    expect(await complete).toEqual([[]]);
+  });
+
+  it('offers nominator-only validator payouts when validator own stake and commission are zero', async (): Promise<void> => {
+    const { validatorPayouts } = fixture([{ id: validatorA, own: 0, pages: [[[alice, 100]]] }]);
+
+    expect(values(await firstValueFrom(validatorPayouts([validatorA.toString()], [era])))).toEqual(['1000']);
+  });
+
+  it('registers both corrected derives in the SORA bundle', (): void => {
+    expect(definitions.derives?.staking._eraExposure).toBe(eraExposure);
+    expect(definitions.derives?.staking._stakerRewards).toBe(stakerRewards);
+    expect(definitions.derives?.staking.soraValidatorRewards).toBe(validatorRewards);
+  });
+});
