+++ b/packages/react-signer/src/directCall.spec.ts
@@ -0,0 +1,35 @@
+// Copyright 2017-2026 @polkadot/react-signer authors & contributors
+// SPDX-License-Identifier: Apache-2.0
+
+/// <reference types="@polkadot/dev-test/globals.d.ts" />
+
+import { assertDirectCall, DIRECT_CALL_ERROR, isDirectCallBlocked } from './directCall.js';
+
+describe('transactions requiring a direct signature', (): void => {
+  it('allows a direct signer', (): void => {
+    const wrapping = { multiRoot: null, proxyRoot: null };
+
+    expect(isDirectCallBlocked(true, wrapping)).toBe(false);
+    expect(() => assertDirectCall(true, wrapping)).not.toThrow();
+  });
+
+  for (const wrapping of [
+    { multiRoot: null, proxyRoot: 'proxy' },
+    { multiRoot: 'multisig', proxyRoot: null },
+    { multiRoot: 'multisig', proxyRoot: 'proxy' }
+  ]) {
+    it(`rejects wrapping before signing: ${JSON.stringify(wrapping)}`, (): void => {
+      expect(isDirectCallBlocked(true, wrapping)).toBe(true);
+      expect(() => assertDirectCall(true, wrapping)).toThrow(DIRECT_CALL_ERROR);
+    });
+  }
+
+  for (const requiresDirectCall of [false, undefined]) {
+    it(`preserves ordinary transaction wrapping when the requirement is ${String(requiresDirectCall)}`, (): void => {
+      const wrapping = { multiRoot: 'multisig', proxyRoot: 'proxy' };
+
+      expect(isDirectCallBlocked(requiresDirectCall, wrapping)).toBe(false);
+      expect(() => assertDirectCall(requiresDirectCall, wrapping)).not.toThrow();
+    });
+  }
+});
diff --git a/packages/react-signer/src/directCall.ts b/packages/react-signer/src/directCall.ts
new file mode 100644
index 0000000..b7b0dad
--- /dev/null
+++ b/packages/react-signer/src/directCall.ts
@@ -0,0 +1,19 @@
+// Copyright 2017-2026 @polkadot/react-signer authors & contributors
+// SPDX-License-Identifier: Apache-2.0
+
+interface CallWrapping {
+  multiRoot: string | null;
+  proxyRoot: string | null;
+}
+
+export const DIRECT_CALL_ERROR = 'This transaction must be signed directly. Disable proxy signing or select a non-multisig account to pay the transaction fee.';
+
+export function isDirectCallBlocked (requiresDirectCall: boolean | undefined, { multiRoot, proxyRoot }: CallWrapping): boolean {
+  return !!requiresDirectCall && !!(multiRoot || proxyRoot);
+}
+
+export function assertDirectCall (requiresDirectCall: boolean | undefined, wrapping: CallWrapping): void {
+  if (isDirectCallBlocked(requiresDirectCall, wrapping)) {
+    throw new Error(DIRECT_CALL_ERROR);
+  }
+}
