+++ b/packages/apps-config/src/api/spec/soraSubstrate/stakingRewards.ts
@@ -0,0 +1,207 @@
+// Copyright 2017-2026 @polkadot/apps-config authors & contributors
+// SPDX-License-Identifier: Apache-2.0
+
+import type { Observable } from 'rxjs';
+import type { DeriveApi, DeriveEraExposurePaged, DeriveStakerReward } from '@polkadot/api-derive/types';
+import type { Compact, Option, StorageKey, Struct, u32, Vec } from '@polkadot/types';
+import type { Balance, EraIndex, Exposure, IndividualExposure } from '@polkadot/types/interfaces';
+
+import { combineLatest, map, of, switchMap } from 'rxjs';
+
+import { _eraExposure, _stakerRewards } from '@polkadot/api-derive/staking';
+import { memo } from '@polkadot/api-derive/util';
+import { BN, BN_BILLION, BN_ZERO } from '@polkadot/util';
+
+// Keep the SORA override independent of a globally selected chain's lookup
+// augmentation: Apps builds this package before loading chain-specific types.
+interface ExposureOverview extends Struct {
+  own: Compact<Balance>;
+  pageCount: u32;
+  total: Compact<Balance>;
+}
+
+interface ExposurePage extends Struct {
+  others: Vec<IndividualExposure>;
+  pageTotal: Compact<Balance>;
+}
+
+interface RewardPage {
+  others: IndividualExposure[];
+  own: BN;
+  page: number;
+  total: BN;
+}
+
+interface RewardExposure extends Exposure {
+  rewardPages: RewardPage[];
+}
+
+type OverviewEntries = [StorageKey, Option<ExposureOverview>][];
+type PageEntries = [StorageKey, Option<ExposurePage>][];
+type LegacyEntries = [StorageKey, Exposure][];
+
+function hasPagedValRewards (api: DeriveApi): boolean {
+  return !!(api.query.xorFee?.valStakingEraReward && api.query.staking.erasStakersPaged && api.query.staking.erasStakersOverview);
+}
+
+function mergeExposure (api: DeriveApi, era: EraIndex, overviews: OverviewEntries, pages: PageEntries, legacy: LegacyEntries): DeriveEraExposurePaged {
+  const validators: Record<string, RewardExposure> = {};
+  const nominators: DeriveEraExposurePaged['nominators'] = {};
+
+  legacy.forEach(([key, exposure]): void => {
+    validators[key.args[1].toString()] = Object.assign(exposure, {
+      rewardPages: [{ others: exposure.others.toArray(), own: exposure.own.unwrap(), page: 0, total: exposure.total.unwrap() }]
+    });
+  });
+
+  overviews.forEach(([key, option]): void => {
+    if (option.isSome) {
+      const validatorId = key.args[1].toString();
+      const overview = option.unwrap();
+      const own = new BN(overview.own.toString());
+      const rewardPages = Array.from({ length: Math.max(1, overview.pageCount.toNumber()) }, (_, page): RewardPage => {
+        const exposure = pages.find(([key]) => key.args[1].toString() === validatorId && key.args[2].toString() === page.toString())?.[1].unwrapOr(null);
+        const pageOwn = page === 0 ? own : BN_ZERO;
+
+        return {
+          others: exposure?.others.toArray() || [],
+          own: pageOwn,
+          page,
+          total: new BN(exposure?.pageTotal.toString() || '0').add(pageOwn)
+        };
+      });
+
+      validators[validatorId] = Object.assign(api.registry.createType<Exposure>('Exposure', {
+        others: rewardPages.flatMap(({ others }) => others),
+        own,
+        total: overview.total
+      }), { rewardPages });
+    }
+  });
+
+  Object.entries(validators).forEach(([validatorId, exposure]): void => {
+    exposure.others.forEach(({ who }, validatorIndex): void => {
+      const stashId = who.toString();
+
+      (nominators[stashId] ||= []).push({ validatorId, validatorIndex });
+    });
+  });
+
+  return { era, nominators, validators };
+}
+
+// Retain every page and the overview's own/total stake. Do not reuse the
+// upstream exposure cache, which may already contain only the last page.
+export function eraExposure (instanceId: string, api: DeriveApi): (era: EraIndex, withActive?: boolean) => Observable<DeriveEraExposurePaged> {
+  const standardExposure = _eraExposure(instanceId, api);
+
+  return memo(instanceId, (era: EraIndex, withActive = false): Observable<DeriveEraExposurePaged> => hasPagedValRewards(api)
+    ? combineLatest([
+      api.query.staking.erasStakersOverview.entries(era),
+      api.query.staking.erasStakersPaged.entries(era),
+      api.query.staking.erasStakersClipped?.entries(era) || of([])
+    ]).pipe(map(([overviews, pages, legacy]) => mergeExposure(api, era, overviews as OverviewEntries, pages as PageEntries, legacy as LegacyEntries)))
+    : standardExposure(era, withActive)
+  );
+}
+
+// Match Perbill::from_rational (floor) and Perbill * Balance (nearest, ties
+// down), including the separate rounding for each page paid by the runtime.
+function multiplyPerbill (parts: BN, value: BN): BN {
+  return parts.mul(value).add(BN_BILLION.divn(2).subn(1)).div(BN_BILLION);
+}
+
+function fraction (numerator: BN, denominator: BN): BN {
+  return numerator.gte(denominator) ? BN_BILLION : numerator.mul(BN_BILLION).div(denominator);
+}
+
+function createRewards (instanceId: string, api: DeriveApi, validatorPayout = false): (accountIds: (Uint8Array | string)[], eras: EraIndex[], withActive?: boolean) => Observable<DeriveStakerReward[][]> {
+  const standardRewards = _stakerRewards(instanceId, api);
+
+  return memo(instanceId, (accountIds: (Uint8Array | string)[], eras: EraIndex[], withActive = false): Observable<DeriveStakerReward[][]> => {
+    if (!hasPagedValRewards(api)) {
+      return standardRewards(accountIds, eras, withActive);
+    }
+
+    if (!accountIds.length || !eras.length) {
+      return of(accountIds.map(() => []));
+    }
+
+    const stashIds = accountIds.map((id) => api.registry.createType('AccountId', id).toString());
+
+    return combineLatest([
+      api.derive.staking._stakerExposures(accountIds, eras, withActive),
+      api.derive.staking._stakerRewardsEras(eras, withActive)
+    ]).pipe(switchMap(([exposures, [points, prefs, rewards]]) => {
+      const keys = [...new Map(exposures.flatMap((stashes) => stashes.flatMap(({ era, validators }) => Object.keys(validators).map((id): [string, [EraIndex, string]] => [`${era.toString()}:${id}`, [era, id]])))).values()];
+      const validatorIds = [...new Set(keys.map(([, id]) => id))];
+
+      return combineLatest([
+        !withActive && keys.length && api.query.staking.claimedRewards
+          ? api.query.staking.claimedRewards.multi(keys)
+          : of(keys.map(() => api.registry.createType('Vec<u32>'))),
+        !withActive && validatorIds.length
+          ? api.derive.staking.queryMulti(validatorIds, { withLedger: true })
+          : of([])
+      ]).pipe(map(([claimed, validators]) => exposures.map((stashes, index) => stashes.flatMap((exposure): DeriveStakerReward[] => {
+        const eraPoints = points.find(({ era }) => era.eq(exposure.era));
+        const eraReward = rewards.find(({ era }) => era.eq(exposure.era))?.eraReward || api.registry.createType<Balance>('Balance');
+        const eraPrefs = prefs.find(({ era }) => era.eq(exposure.era));
+        const pending: DeriveStakerReward['validators'] = {};
+
+        Object.entries(exposure.validators).forEach(([validatorId, value]): void => {
+          const { rewardPages, total } = value as RewardExposure;
+          const valPoints = eraPoints?.validators[validatorId];
+          const ledger = validators.find(({ accountId }) => accountId.toString() === validatorId)?.stakingLedger;
+          const legacyClaims: readonly EraIndex[] = ledger?.legacyClaimedRewards || (ledger as unknown as { claimedRewards?: EraIndex[] })?.claimedRewards || [];
+
+          if (!rewardPages || total.unwrap().isZero() || !valPoints || !eraPoints || eraPoints.eraPoints.isZero() || (!withActive && legacyClaims.some((era) => era.eq(exposure.era)))) {
+            return;
+          }
+
+          // The standalone apps-config build has generic storage Codec types.
+          // eslint-disable-next-line @typescript-eslint/no-unnecessary-type-assertion
+          const claimedPages = claimed[keys.findIndex(([era, id]) => era.eq(exposure.era) && id === validatorId)] as Vec<u32>;
+          const unpaid = rewardPages.filter(({ page }) => !claimedPages.some((claimed) => claimed.eqn(page)));
+
+          if (!unpaid.length) {
+            return;
+          }
+
+          const validatorReward = multiplyPerbill(fraction(valPoints, eraPoints.eraPoints), eraReward);
+          const commission = multiplyPerbill(eraPrefs?.validators[validatorId]?.commission.unwrap() || BN_ZERO, validatorReward);
+          const leftover = validatorReward.sub(commission);
+          const isValidator = validatorId === stashIds[index];
+          const reward = unpaid.reduce((sum, page) => {
+            const stakes = isValidator
+              ? validatorPayout ? [page.own, ...page.others.map(({ value }) => value.unwrap())] : [page.own]
+              : [page.others.find(({ who }) => who.toString() === stashIds[index])?.value.unwrap() || BN_ZERO];
+            const stakingReward = stakes.reduce((sum, stake) => sum.add(multiplyPerbill(fraction(stake, total.unwrap()), leftover)), new BN(0));
+
+            return sum.add(stakingReward).add(isValidator ? multiplyPerbill(fraction(page.total, total.unwrap()), commission) : BN_ZERO);
+          }, new BN(0));
+
+          // A nominator whose own page is paid has no pending contribution,
+          // even if other pages for the same validator remain unpaid.
+          if (!reward.isZero()) {
+            pending[validatorId] = { total: api.registry.createType('Balance', validatorReward), value: api.registry.createType('Balance', reward) };
+          }
+        });
+
+        return Object.keys(pending).length
+          ? [{ ...exposure, eraReward, isClaimed: false, isEmpty: false, nominating: exposure.nominating.filter(({ validatorId }) => !!pending[validatorId]), validators: pending }]
+          : [];
+      }))));
+    }));
+  });
+}
+
+export function stakerRewards (instanceId: string, api: DeriveApi): ReturnType<typeof createRewards> {
+  return createRewards(instanceId, api);
+}
+
+// The Own validators screen requests the whole pending page, including every
+// nominator. Keep its claim subscription and rounding identical to stash mode.
+export function validatorRewards (instanceId: string, api: DeriveApi): ReturnType<typeof createRewards> {
+  return createRewards(`${instanceId}-validator-payout`, api, true);
+}
