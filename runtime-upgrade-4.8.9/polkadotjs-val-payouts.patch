new file mode 100644
index 0000000..6b24fc9
--- /dev/null
+++ b/packages/page-staking/src/Payouts/transactions.spec.ts
@@ -0,0 +1,67 @@
+// Copyright 2017-2026 @polkadot/app-staking authors & contributors
+// SPDX-License-Identifier: Apache-2.0
+
+/// <reference types="@polkadot/dev-test/globals.d.ts" />
+
+import type { ApiPromise } from '@polkadot/api';
+import type { EraIndex } from '@polkadot/types/interfaces';
+import type { PayoutValidator } from './types.js';
+
+import { BN } from '@polkadot/util';
+
+import { createPayoutExtrinsics, getPendingPayouts, MAX_DIRECT_PAYOUTS } from './transactions.js';
+
+function payout (validatorId: string, eras: [number, boolean][]): PayoutValidator {
+  return {
+    available: new BN(1),
+    eras: eras.map(([era, isClaimed]) => ({ era: new BN(era) as EraIndex, isClaimed, stashes: {} })),
+    total: new BN(1),
+    validatorId
+  };
+}
+
+describe('staking payout transactions', (): void => {
+  it('keeps payable eras when another validator has already claimed and sorts oldest first', (): void => {
+    const payouts = [payout('Alice', [[12, false], [8, true]]), payout('Bob', [[6, true]]), payout('Charlie', [[7, false]])];
+
+    expect(getPendingPayouts(payouts, true).map(({ era, validatorId }) => [era.toNumber(), validatorId])).toEqual([
+      [7, 'Charlie'],
+      [12, 'Alice']
+    ]);
+    expect(payouts[0].eras.map(({ era }) => era.toNumber())).toEqual([12, 8]);
+  });
+
+  it('bounds VAL payouts and constructs only direct staking calls', (): void => {
+    const payouts = payout('Alice', Array.from({ length: MAX_DIRECT_PAYOUTS + 5 }, (_, i) => [MAX_DIRECT_PAYOUTS + 4 - i, false]));
+
+    const unexpectedBatch = (): never => {
+      throw new Error('VAL payouts must not be wrapped in utility calls');
+    };
+
+    const api = {
+      tx: {
+        staking: {
+          payoutStakers: (validatorId: string, era: EraIndex) => ({ method: { args: [validatorId, era], method: 'payoutStakers', section: 'staking' } })
+        },
+        utility: { batch: unexpectedBatch, batchAll: unexpectedBatch, forceBatch: unexpectedBatch }
+      }
+    } as unknown as ApiPromise;
+    const txs = createPayoutExtrinsics(api, getPendingPayouts(payouts, true));
+
+    expect(txs).toHaveLength(MAX_DIRECT_PAYOUTS);
+    expect(txs.map(({ method }) => [method.section, method.method, method.args[0].toString(), method.args[1].toString()])).toEqual(
+      Array.from({ length: MAX_DIRECT_PAYOUTS }, (_, era) => ['staking', 'payoutStakers', 'Alice', era.toString()])
+    );
+  });
+
+  it('leaves the normal staking batch input uncapped', (): void => {
+    const payouts = payout('Alice', Array.from({ length: MAX_DIRECT_PAYOUTS + 5 }, (_, era) => [era, false]));
+
+    expect(getPendingPayouts(payouts, false)).toHaveLength(MAX_DIRECT_PAYOUTS + 5);
+  });
+
+  it('does not create transactions for empty or fully claimed rewards', (): void => {
+    expect(getPendingPayouts([], true)).toEqual([]);
+    expect(getPendingPayouts(payout('Alice', [[7, true]]), true)).toEqual([]);
+  });
+});
