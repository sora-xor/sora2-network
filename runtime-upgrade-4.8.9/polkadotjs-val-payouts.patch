@@ -0,0 +1,33 @@
+// Copyright 2017-2026 @polkadot/app-staking authors & contributors
+// SPDX-License-Identifier: Apache-2.0
+
+import type { ApiPromise } from '@polkadot/api';
+import type { SubmittableExtrinsic } from '@polkadot/api/types';
+import type { EraIndex } from '@polkadot/types/interfaces';
+import type { PayoutValidator } from './types.js';
+
+export const MAX_DIRECT_PAYOUTS = 40;
+
+export interface SinglePayout {
+  era: EraIndex;
+  validatorId: string;
+}
+
+export function getPendingPayouts (payout: PayoutValidator | PayoutValidator[], isValPayout: boolean): SinglePayout[] {
+  const pending = (Array.isArray(payout) ? payout : [payout])
+    .flatMap(({ eras, validatorId }) => eras
+      .filter(({ isClaimed }) => !isClaimed)
+      .map(({ era }) => ({ era, validatorId }))
+    )
+    .sort((a, b) => a.era.cmp(b.era));
+
+  return isValPayout
+    ? pending.slice(0, MAX_DIRECT_PAYOUTS)
+    : pending;
+}
+
+export function createPayoutExtrinsics (api: ApiPromise, payouts: SinglePayout[]): SubmittableExtrinsic<'promise'>[] {
+  // Deployed SORA runtimes use an outer-call VAL hook. Keep direct claims
+  // compatible with those runtimes until wrapped payouts are supported there.
+  return payouts.map(({ era, validatorId }) => api.tx.staking.payoutStakers(validatorId, era));
+}
