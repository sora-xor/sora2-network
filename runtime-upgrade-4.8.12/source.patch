+            ));
+            assert_ok!(ApolloPlatform::get_rewards(
+                RuntimeOrigin::signed(alice()),
+                DOT,
+                true
+            ));
+            assert_eq!(
+                Assets::free_balance(&APOLLO_ASSET_ID, &alice()).unwrap() - rewards_before,
+                balance!(10)
