+            ),
+            (
+                vec![(id, vec![own, 999999])],
+                order_book::Error::<Runtime>::UnknownLimitOrder,
+            ),
+            (
+                vec![(id, vec![own, foreign])],
+                order_book::Error::<Runtime>::Unauthorized,
+            ),
