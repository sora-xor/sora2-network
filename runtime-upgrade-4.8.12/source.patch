+#[test]
+fn equivocation_reports_reject_all_unsigned_sources_and_publication() {
+	use sp_runtime::transaction_validity::{InvalidTransaction, TransactionSource};
+
+	build_and_execute_with_pairs(3, |pairs| {
+		start_era(1);
+
+		let authorities = Authorities::<Test>::get();
+
+		// generate and report an equivocation for the validator at index 0
+		let offending_validator_index = 0;
+		let offending_authority_pair = pairs
+			.into_iter()
+			.find(|p| p.public() == authorities[offending_validator_index].0)
+			.unwrap();
+
+		let equivocation_proof = generate_equivocation_proof(
+			offending_validator_index as u32,
+			&offending_authority_pair,
+			CurrentSlot::<Test>::get(),
+		);
+
+		let key = (sp_consensus_babe::KEY_TYPE, &offending_authority_pair.public());
+		let key_owner_proof = Historical::prove(key).unwrap();
+
+		let call = Call::report_equivocation_unsigned {
+			equivocation_proof: Box::new(equivocation_proof.clone()),
+			key_owner_proof: key_owner_proof.clone(),
+		};
+
+		let calls = [
+			Call::report_equivocation {
+				equivocation_proof: Box::new(equivocation_proof.clone()),
+				key_owner_proof: key_owner_proof.clone(),
+			},
+			call,
+		];
+		for call in &calls {
+			for source in
+				[TransactionSource::External, TransactionSource::Local, TransactionSource::InBlock]
+			{
+				assert_eq!(
+					<Babe as sp_runtime::traits::ValidateUnsigned>::validate_unsigned(source, call),
+					InvalidTransaction::Call.into(),
+				);
+			}
+			assert_err!(
+				<Babe as sp_runtime::traits::ValidateUnsigned>::pre_dispatch(call),
+				InvalidTransaction::Call,
+			);
+		}
+
+		// No offchain host or transaction-pool extension is installed. This must
+		// return without attempting the former unsigned publication path.
+		assert_eq!(
+			Babe::submit_unsigned_equivocation_report(
+				equivocation_proof.clone(),
+				key_owner_proof.clone(),
+			),
+			None,
+		);
+
+		for result in [
+			Babe::report_equivocation(
+				RuntimeOrigin::none(),
+				Box::new(equivocation_proof.clone()),
+				key_owner_proof.clone(),
+			),
+			Babe::report_equivocation_unsigned(
+				RuntimeOrigin::none(),
+				Box::new(equivocation_proof.clone()),
+				key_owner_proof.clone(),
+			),
+		] {
+			let error = result.unwrap_err();
+			assert_eq!(error.error, sp_runtime::DispatchError::BadOrigin);
+			assert_eq!(error.post_info.pays_fee, Pays::Yes);
+		}
+	});
+}
