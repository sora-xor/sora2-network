+#[test]
+fn requested_preimage_first_provision_refunds_but_replay_keeps_fees() {
+	new_test_ext().execute_with(|| {
+		let bytes = vec![42; 4096];
+		let hash = hashed(&bytes);
+		assert_ok!(Preimage::request_preimage(RuntimeOrigin::signed(1), hash));
+		assert_ok!(Preimage::request_preimage(RuntimeOrigin::signed(1), hash));
+		let first = Preimage::note_preimage(RuntimeOrigin::signed(2), bytes.clone()).unwrap();
+		assert_eq!(first.pays_fee, Pays::No);
+		assert_eq!(Balances::free_balance(2), 100);
+		assert_eq!(
+			RequestStatusFor::<Test>::get(hash),
+			Some(RequestStatus::Requested {
+				maybe_ticket: None,
+				count: 2,
+				maybe_len: Some(bytes.len() as u32),
+			})
+		);
+		for sender in [2, 3] {
+			let before = sp_io::storage::root(sp_runtime::StateVersion::V1);
+			let err =
+				Preimage::note_preimage(RuntimeOrigin::signed(sender), bytes.clone()).unwrap_err();
+			assert_eq!(err.error, Error::<Test>::AlreadyNoted.into());
+			assert_eq!(err.post_info.pays_fee, Pays::Yes);
+			assert_eq!(sp_io::storage::root(sp_runtime::StateVersion::V1), before);
+		}
+		assert_eq!(Preimage::get_preimage(&hash), Some(bytes));
+	});
