+            request.tx_hash = H256::repeat_byte(0x72);
+        }
+        let invalid = RuntimeCall::EthBridge(eth_bridge::Call::import_incoming_request {
+            load_incoming_request,
+            incoming_request_result: Ok(request),
+        });
