+            collateral_asset_id: PSWAP,
+            stablecoin_asset_id: KUSD,
+        })
+        .unwrap();
+        assert_eq!(collateral.total_collateral, 0);
+        assert_eq!(collateral.stablecoin_supply, 0);
+    });
