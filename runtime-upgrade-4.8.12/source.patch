+        );
+        let RuntimeCall::EthBridge(eth_bridge::Call::import_incoming_request {
+            load_incoming_request,
+            incoming_request_result: Ok(mut request),
+        }) = call.clone()
+        else {
+            panic!("fixture")
+        };
