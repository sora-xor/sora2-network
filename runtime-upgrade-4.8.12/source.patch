+			);
+
+			// create the key ownership proof.
+			let key_owner_proof = Historical::prove((
+				sp_consensus_babe::KEY_TYPE,
+				&offending_authority_pair.public(),
+			))
+			.unwrap();
+
+			let call = if legacy_alias {
+				Call::<Test>::report_equivocation_unsigned {
+					equivocation_proof: Box::new(equivocation_proof.clone()),
+					key_owner_proof: key_owner_proof.clone(),
+				}
+			} else {
+				Call::<Test>::report_equivocation {
+					equivocation_proof: Box::new(equivocation_proof.clone()),
+					key_owner_proof: key_owner_proof.clone(),
+				}
+			};
+			let info = call.get_dispatch_info();
+			assert!(info.call_weight.ref_time() > 0);
+			assert_eq!(info.pays_fee, Pays::Yes);
+
+			let report = || {
+				if legacy_alias {
+					Babe::report_equivocation_unsigned(
+						RuntimeOrigin::signed(42),
+						Box::new(equivocation_proof.clone()),
+						key_owner_proof.clone(),
+					)
+				} else {
+					Babe::report_equivocation(
+						RuntimeOrigin::signed(42),
+						Box::new(equivocation_proof.clone()),
+						key_owner_proof.clone(),
+					)
+				}
+			};
+			let post_info = report().unwrap();
+			assert!(post_info.actual_weight.is_none());
+			assert_eq!(post_info.pays_fee, Pays::Yes);
+
+			let duplicate = report().unwrap_err();
+			assert_eq!(duplicate.error, Error::<Test>::DuplicateOffenceReport.into());
+			assert!(duplicate.post_info.actual_weight.is_none());
+			assert_eq!(duplicate.post_info.pays_fee, Pays::Yes);
+		});
