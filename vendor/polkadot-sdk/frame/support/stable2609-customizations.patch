+#[test]
+fn clone_no_bound_preserves_generic_field_cloning() {
+	use core::{cell::Cell, marker::PhantomData};
+	use std::rc::Rc;
+
+	struct NotClone;
+	struct Tracked(Rc<Cell<usize>>, u8);
+	impl Clone for Tracked {
+		fn clone(&self) -> Self {
+			self.0.set(self.0.get() + 1);
+			Self(Rc::clone(&self.0), self.1)
+		}
+	}
+
+	#[derive(crate::CloneNoBound)]
+	struct Named<T> {
+		__clone_no_bound_field: u8,
+		tracked: Tracked,
+		marker: PhantomData<T>,
+	}
+	#[derive(crate::CloneNoBound)]
+	struct Tuple<T>(u8, Tracked, PhantomData<T>);
+	#[derive(crate::CloneNoBound)]
+	enum Variant<T> {
+		Named { __clone_no_bound_field: u8, tracked: Tracked, marker: PhantomData<T> },
+		Tuple(u8, Tracked, PhantomData<T>),
+		Unit,
+	}
+	#[derive(crate::CloneNoBound)]
+	struct Unit;
+	#[derive(crate::CloneNoBound)]
+	enum Empty {}
+
+	let count = Rc::new(Cell::new(0));
+	let named = Named::<NotClone> {
+		__clone_no_bound_field: 17,
+		tracked: Tracked(Rc::clone(&count), 42),
+		marker: PhantomData,
+	};
+	let named_clone = named.clone();
+	assert_eq!((named_clone.__clone_no_bound_field, named_clone.tracked.1), (17, 42));
+	assert_eq!(count.get(), 1);
+	let tuple = Tuple::<NotClone>(17, Tracked(Rc::clone(&count), 42), PhantomData).clone();
+	assert_eq!((tuple.0, tuple.1 .1), (17, 42));
+	assert_eq!(count.get(), 2);
+	let variant = Variant::<NotClone>::Named {
+		__clone_no_bound_field: 17,
+		tracked: Tracked(Rc::clone(&count), 42),
+		marker: PhantomData,
+	}
+	.clone();
+	assert!(matches!(
+		variant,
+		Variant::Named { __clone_no_bound_field: 17, tracked: Tracked(_, 42), .. }
+	));
+	assert_eq!(count.get(), 3);
+	let variant =
+		Variant::<NotClone>::Tuple(17, Tracked(Rc::clone(&count), 42), PhantomData).clone();
+	assert!(matches!(variant, Variant::Tuple(17, Tracked(_, 42), _)));
+	assert_eq!(count.get(), 4);
+	assert!(matches!(Variant::<NotClone>::Unit.clone(), Variant::Unit));
+	let _: Unit = Unit.clone();
+	let _: fn(&Empty) -> Empty = Empty::clone;
+	assert_eq!(count.get(), 4);
+}
