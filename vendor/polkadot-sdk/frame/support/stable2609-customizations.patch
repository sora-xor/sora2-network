+#[cfg(test)]
+mod tuple_pause_tests {
+	use super::QueuePausedQuery;
+
+	struct Active;
+	struct Paused;
+	struct NeverCalled;
+
+	impl QueuePausedQuery<()> for Active {
+		fn is_paused(_: &()) -> bool {
+			false
+		}
+	}
+
+	impl QueuePausedQuery<()> for Paused {
+		fn is_paused(_: &()) -> bool {
+			true
+		}
+	}
+
+	impl QueuePausedQuery<()> for NeverCalled {
+		fn is_paused(_: &()) -> bool {
+			panic!("tuple pause queries must short-circuit")
+		}
+	}
+
+	#[test]
+	fn tuple_pause_queries_preserve_empty_and_short_circuit_behavior() {
+		assert!(!<() as QueuePausedQuery<()>>::is_paused(&()));
+		assert!(!<(Active, Active) as QueuePausedQuery<()>>::is_paused(&()));
+		assert!(<(Active, Paused, NeverCalled) as QueuePausedQuery<()>>::is_paused(&()));
+	}
+}
