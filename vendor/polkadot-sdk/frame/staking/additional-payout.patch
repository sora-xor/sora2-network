+#[test]
+fn additional_payout_failure_rolls_back_claim_and_hook_writes() {
+	ExtBuilder::default().build_and_execute(|| {
+		Staking::reward_by_ids(vec![(11, 10)]);
+		start_active_era(1);
+		let exposure = EraInfo::<Test>::get_paged_exposure(0, &11, 0).unwrap();
+		sp_io::storage::set(ADDITIONAL_PAYOUT_MODE, &[2]);
+		let weight = <Test as Config>::WeightInfo::payout_stakers_alive_staked(
+			exposure.others().len() as u32,
+		)
+		.saturating_add(MockAdditionalPayout::weight(exposure.others().len() as u32));
+
+		assert_noop!(
+			Staking::payout_stakers_by_page(RuntimeOrigin::signed(1337), 11, 0, 0),
+			sp_runtime::DispatchError::Other("additional reward failed").with_weight(weight),
+		);
+		assert!(ClaimedRewards::<Test>::get(0, 11).is_empty());
+		assert!(!sp_io::storage::exists(ADDITIONAL_PAYOUT_RECORD));
+
+		// The same claim remains payable after the additional asset recovers.
+		sp_io::storage::set(ADDITIONAL_PAYOUT_MODE, &[1]);
+		assert_ok!(Staking::payout_stakers_by_page(RuntimeOrigin::signed(1337), 11, 0, 0));
+		assert_eq!(ClaimedRewards::<Test>::get(0, 11), vec![0]);
+		assert_eq!(
+			sp_io::storage::get(ADDITIONAL_PAYOUT_RECORD).unwrap().as_ref(),
+			&(11u64, 0u32, 0u32).encode()[..],
+		);
+		assert_noop!(
+			Staking::payout_stakers_by_page(RuntimeOrigin::signed(1337), 11, 0, 0),
+			Error::<Test>::AlreadyClaimed
+				.with_weight(<Test as Config>::WeightInfo::payout_stakers_alive_staked(0),),
+		);
+	});
+}
+
+#[test]
+fn additional_payout_weight_is_retained_when_native_reward_is_zero() {
+	ExtBuilder::default().build_and_execute(|| {
+		Staking::reward_by_ids(vec![(11, 10)]);
+		start_active_era(1);
+		ErasValidatorReward::<Test>::insert(0, 0);
+		sp_io::storage::set(ADDITIONAL_PAYOUT_MODE, &[1]);
+		let exposure = EraInfo::<Test>::get_paged_exposure(0, &11, 0).unwrap();
+		assert!(!exposure.others().is_empty());
+		let expected = <Test as Config>::WeightInfo::payout_stakers_alive_staked(0)
+			.saturating_add(MockAdditionalPayout::weight(exposure.others().len() as u32));
+		let declared =
+			<Test as Config>::WeightInfo::payout_stakers_alive_staked(MaxExposurePageSize::get())
+				.saturating_add(MockAdditionalPayout::weight(MaxExposurePageSize::get()));
+		let call = TestCall::Staking(StakingCall::payout_stakers { validator_stash: 11, era: 0 });
+		let info = call.get_dispatch_info();
+		assert_eq!(info.call_weight, declared);
+		let by_page = TestCall::Staking(StakingCall::payout_stakers_by_page {
+			validator_stash: 11,
+			era: 0,
+			page: 0,
+		});
+		assert_eq!(by_page.get_dispatch_info().call_weight, declared);
+		let result = call.dispatch(RuntimeOrigin::signed(1337));
+		assert_ok!(result);
+		assert_eq!(extract_actual_weight(&result, &info), expected);
+		assert!(sp_io::storage::exists(ADDITIONAL_PAYOUT_RECORD));
 	});
