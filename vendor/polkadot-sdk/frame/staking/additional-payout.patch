 /// Counter for the number of "reward" points earned by a given validator.
 pub type RewardPoint = u32;
+
+/// Additional rewards paid atomically with a staking exposure-page claim.
+///
+/// Implementations must not dispatch another staking payout or change staking exposure, reward
+/// points, preferences, or claim bookkeeping. An error rolls back the entire payout, including
+/// the claimed-page marker, so the page can be retried. `weight` must conservatively cover all
+/// work done by `payout` for a page with up to `nominators` nominators, including failure paths.
+pub trait AdditionalPayout<AccountId> {
+	fn payout(validator_stash: &AccountId, era: EraIndex, page: Page)
+		-> sp_runtime::DispatchResult;
+	fn weight(nominators: u32) -> Weight;
+}
+
+impl<AccountId> AdditionalPayout<AccountId> for () {
+	fn payout(_: &AccountId, _: EraIndex, _: Page) -> sp_runtime::DispatchResult {
+		Ok(())
+	}
+
+	fn weight(_: u32) -> Weight {
+		Weight::zero()
+	}
+}
 
 /// The balance type of this pallet.
 pub type BalanceOf<T> = <T as Config>::CurrencyBalance;
