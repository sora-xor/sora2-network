+#[test]
+fn deferred_slash_late_first_report_is_applied_with_its_original_era() {
+	// Reports are still admissible in the last bonded era. Exercise both the
+	// execution era itself and a later era, after their queue keys were drained.
+	for defer in [1, 2] {
+		ExtBuilder::default().slash_defer_duration(defer).build_and_execute(|| {
+			mock::start_active_era(1);
+			assert_eq!(BondingDuration::get(), 3);
+			assert_ok!(Staking::chill(RuntimeOrigin::signed(11)));
+			assert_ok!(Staking::unbond(RuntimeOrigin::signed(11), 500));
+			mock::start_active_era(4);
+			assert!(BondedEras::<Test>::get().iter().any(|(era, _)| *era == 1));
+
+			on_offence_in_era(&[offence_from(11, None)], &[Perbill::from_percent(10)], 1);
+
+			assert_eq!(asset::stakeable_balance::<Test>(&11), 900);
+			let ledger = Staking::ledger(11.into()).unwrap();
+			assert_eq!(ledger.active, 450);
+			assert_eq!(
+				ledger.unlocking.as_slice(),
+				&[UnlockChunk { era: 4, value: 450 as Balance }],
+			);
+			assert!(UnappliedSlashes::<Test>::get(1 + defer + 1).is_empty());
+		});
+	}
+}
+
+#[test]
+fn deferred_slash_late_increment_only_collects_the_remaining_amount() {
+	ExtBuilder::default().slash_defer_duration(2).build_and_execute(|| {
+		mock::start_active_era(1);
+		on_offence_now(&[offence_from(11, None)], &[Perbill::from_percent(10)]);
+		mock::start_active_era(4);
+		assert_eq!(asset::stakeable_balance::<Test>(&11), 900);
+
+		on_offence_in_era(&[offence_from(11, None)], &[Perbill::from_percent(20)], 1);
+		assert_eq!(asset::stakeable_balance::<Test>(&11), 800);
+		assert!(UnappliedSlashes::<Test>::get(4).is_empty());
+
+		// Repeating the same severity must not collect the increment again.
+		on_offence_in_era(&[offence_from(11, None)], &[Perbill::from_percent(20)], 1);
+		assert_eq!(asset::stakeable_balance::<Test>(&11), 800);
+	});
+}
+
+#[test]
+fn deferred_slash_retains_stake_until_the_execution_era_is_active() {
+	ExtBuilder::default().slash_defer_duration(2).build_and_execute(|| {
+		mock::start_active_era(1);
+		on_offence_now(&[offence_from(11, None)], &[Perbill::from_percent(10)]);
+		assert_ok!(Staking::chill(RuntimeOrigin::signed(11)));
+		assert_ok!(Staking::unbond(RuntimeOrigin::signed(11), 1000));
+		let spans = SlashingSpans::<Test>::get(11).unwrap().iter().count() as u32;
+
+		// Drive real session rotation to the last session before execution.
+		// Planning advances CurrentEra one session before ActiveEra advances.
+		mock::start_session(4 * SessionsPerEra::get() - 1);
+		assert_eq!(current_era(), 4);
+		assert_eq!(active_era(), 3);
+		assert_ok!(Staking::withdraw_unbonded(RuntimeOrigin::signed(11), spans));
+		assert_eq!(
+			Ledger::<Test>::get(11).map(|ledger| ledger.total),
+			Some(1000),
+			"stake must remain available for the already queued slash",
+		);
+		assert_eq!(UnappliedSlashes::<Test>::get(4).len(), 1);
+
+		mock::start_active_era(4);
+		assert_eq!(asset::stakeable_balance::<Test>(&11), 900);
+		assert_ok!(Staking::withdraw_unbonded(RuntimeOrigin::signed(11), spans));
+		assert!(!Ledger::<Test>::contains_key(11));
+	});
+}
