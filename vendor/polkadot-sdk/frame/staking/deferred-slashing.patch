+#[test]
+fn deferred_slash_uses_the_original_era_for_unlocking_proportions() {
+	ExtBuilder::default().slash_defer_duration(2).build_and_execute(|| {
+		mock::start_active_era(1);
+		on_offence_now(&[offence_from(11, None)], &[Perbill::from_percent(10)]);
+		// Existing queue encoding and execution-era keys remain unchanged.
+		assert_eq!(UnappliedSlashes::<Test>::get(4).len(), 1);
+		assert_ok!(Staking::chill(RuntimeOrigin::signed(11)));
+		assert_ok!(Staking::unbond(RuntimeOrigin::signed(11), 500));
+		mock::start_active_era(4);
+
+		let ledger = Staking::ledger(11.into()).unwrap();
+		assert_eq!(ledger.active, 450);
+		assert_eq!(
+			ledger.unlocking.as_slice(),
+			&[UnlockChunk { era: 4, value: 450 as Balance }],
+		);
+		assert_eq!(ledger.total, 900);
+		assert!(UnappliedSlashes::<Test>::get(4).is_empty());
+	});
