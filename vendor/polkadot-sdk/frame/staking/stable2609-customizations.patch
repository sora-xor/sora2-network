+            for n in start..(start + MaxControllersInDeprecationBatch::get()).into() {
+                let ctlr: u64 = n.into();
+
+                // Only half of entries are unique pairs.
+                let stash: u64 = if n % 2 == 0 { (n + 10000).into() } else { ctlr };
