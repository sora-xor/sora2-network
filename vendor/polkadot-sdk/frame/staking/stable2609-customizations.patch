+        // This chunk is locked at `current_era` through `current_era + 2` (because
+        // `BondingDuration` == 3).
+        assert_ok!(Staking::unbond(RuntimeOrigin::signed(11), 1));
+        assert_eq!(
+            Staking::ledger(11.into())
+                .map(|l| l.unlocking.len())
+                .unwrap(),
