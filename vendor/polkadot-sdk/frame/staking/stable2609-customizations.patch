+    #[test]
+    fn overstaked_and_partially_unbonding() {
+        ExtBuilder::default()
+            .has_stakers(true)
+            .build_and_execute(|| {
+                // GIVEN alice who is a nominator with T::OldCurrency.
+                let alice = 300;
+                // 1000 + ED
+                let _ = Balances::make_free_balance_be(&alice, 1001);
+                let stake = 600;
+                let reserved_by_another_pallet = 400;
