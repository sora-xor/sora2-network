+                11,
+                test_era
+            ));
+            assert_eq!(ClaimedRewards::<Test>::get(test_era, &11), vec![2, 0]);
+
+            // cannot claim page 2 again
+            assert_noop!(
+                Staking::payout_stakers_by_page(RuntimeOrigin::signed(1337), 11, test_era, 2),
