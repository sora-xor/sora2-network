+/// Read Cargo's build-script timestamp, accepting both current and legacy layouts.
+fn invoked_timestamp_mtime(out_dir: &Path) -> std::io::Result<filetime::FileTime> {
+	let metadata = fs::metadata(out_dir.join("../run/invoked.timestamp")).or_else(|error| {
+		if error.kind() == std::io::ErrorKind::NotFound {
+			fs::metadata(out_dir.join("../invoked.timestamp"))
+		} else {
+			Err(error)
+		}
+	})?;
+	Ok(filetime::FileTime::from_last_modification_time(&metadata))
 }
 
