+#[cfg(test)]
+mod tests {
+	use super::*;
+	use filetime::FileTime;
+
+	fn timestamp_fixture() -> (tempfile::TempDir, PathBuf) {
+		let directory = tempfile::tempdir().unwrap();
+		let out_dir = directory.path().join("out");
+		fs::create_dir(&out_dir).unwrap();
+		(directory, out_dir)
+	}
+
+	fn write_timestamp(path: &Path, seconds: i64) -> FileTime {
+		fs::create_dir_all(path.parent().unwrap()).unwrap();
+		fs::write(path, []).unwrap();
+		let mtime = FileTime::from_unix_time(seconds, 0);
+		filetime::set_file_mtime(path, mtime).unwrap();
+		mtime
+	}
+
+	#[test]
+	fn invoked_timestamp_supports_current_cargo_layout() {
+		let (directory, out_dir) = timestamp_fixture();
+		let expected = write_timestamp(&directory.path().join("run/invoked.timestamp"), 1_000_000);
+		assert_eq!(invoked_timestamp_mtime(&out_dir).unwrap(), expected);
+	}
+
+	#[test]
+	fn invoked_timestamp_supports_legacy_cargo_layout() {
+		let (directory, out_dir) = timestamp_fixture();
+		let expected = write_timestamp(&directory.path().join("invoked.timestamp"), 1_000_000);
+		assert_eq!(invoked_timestamp_mtime(&out_dir).unwrap(), expected);
+	}
+
+	#[test]
+	fn invoked_timestamp_prefers_current_cargo_layout() {
+		let (directory, out_dir) = timestamp_fixture();
+		write_timestamp(&directory.path().join("invoked.timestamp"), 1_000_000);
+		let expected = write_timestamp(&directory.path().join("run/invoked.timestamp"), 2_000_000);
+		assert_eq!(invoked_timestamp_mtime(&out_dir).unwrap(), expected);
+	}
+
+	#[test]
+	fn invoked_timestamp_reports_missing_timestamp() {
+		let (_directory, out_dir) = timestamp_fixture();
+		assert_eq!(
+			invoked_timestamp_mtime(&out_dir).unwrap_err().kind(),
+			std::io::ErrorKind::NotFound,
+		);
+	}
+
+	#[test]
+	fn invoked_timestamp_preserves_non_missing_io_errors() {
+		let (directory, out_dir) = timestamp_fixture();
+		write_timestamp(&directory.path().join("invoked.timestamp"), 1_000_000);
+		// A non-directory component must not be hidden by the valid legacy timestamp.
+		fs::write(directory.path().join("run"), []).unwrap();
+		assert_eq!(
+			invoked_timestamp_mtime(&out_dir).unwrap_err().kind(),
+			std::io::ErrorKind::NotADirectory,
+		);
+	}
+}
